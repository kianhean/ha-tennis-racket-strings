{
  "entity": {
    "binary_sensor": {
      "restring_due": {
        "default": "mdi:calendar-clock",
        "state": {
          "on": "mdi:calendar-alert"
        }
      }
    },
    "button": {
      "repeat_restring": {
        "default": "mdi:repeat"
      }
    },
    "calendar": {
      "restrings": {
        "default": "mdi:calendar-multiple"
      }
    },
    "image": {
      "photo": {
        "default": "mdi:camera"
      }
    },
    "sensor": {
      "strings": {
        "default": "mdi:tennis"
      },
      "tension": {
        "default": "mdi:arrow-expand-horizontal"
      },
      "last_restrung": {
        "default": "mdi:calendar-check"
      },
      "days_since_restring": {
        "default": "mdi:timer-sand",
        "range": {
          "0": "mdi:timer-sand-empty",
          "30": "mdi:timer-sand",
          "90": "mdi:timer-sand-full"
        }
      },
      "next_restring": {
        "default": "mdi:calendar-arrow-right"
      },
      "restrings": {
        "default": "mdi:history"
      },
      "total_cost": {
        "default": "mdi:cash-multiple"
      },
      "estimated_tension": {
        "default": "mdi:arrow-collapse-horizontal"
      },
      "estimated_tension_loss": {
        "default": "mdi:trending-down"
      },
      "hours_played": {
        "default": "mdi:clock-outline"
      },
      "strung_weight": {
        "default": "mdi:weight-gram"
      },
      "unstrung_weight": {
        "default": "mdi:weight-gram"
      },
      "balance": {
        "default": "mdi:scale-balance"
      },
      "swingweight": {
        "default": "mdi:rotate-right"
      },
      "stiffness": {
        "default": "mdi:arrow-collapse-vertical"
      },
      "length": {
        "default": "mdi:ruler"
      },
      "tension_min": {
        "default": "mdi:arrow-collapse-horizontal"
      },
      "tension_max": {
        "default": "mdi:arrow-expand-horizontal"
      }
    }
  },
  "services": {
    "add_restring": {
      "service": "mdi:tennis"
    },
    "repeat_restring": {
      "service": "mdi:repeat"
    },
    "update_restring": {
      "service": "mdi:pencil"
    },
    "delete_restring": {
      "service": "mdi:delete"
    },
    "get_history": {
      "service": "mdi:history"
    }
  }
}
